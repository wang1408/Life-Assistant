APP_ENV=development
DATABASE_URL=sqlite:///./life_assistant.db
REDIS_URL=redis://localhost:6379/0
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_FAST_MODEL=qwen-turbo
QWEN_SMART_MODEL=qwen-plus
AMAP_API_KEY=your-amap-api-key
QWEATHER_API_KEY=your-qweather-api-key
# 和风天气控制台 -> 设置中显示的项目专属 API Host，不要填 api.qweather.com/devapi.qweather.com
QWEATHER_API_HOST=n76hf2pqjk.re.qweatherapi.com
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your-163-email@163.com
SMTP_PASSWORD=your-163-authorization-code
SMTP_FROM=your-163-email@163.com
REMINDER_EMAIL_TO=your-163-email@163.com
REMINDER_TIMEZONE=Asia/Shanghai
REMINDER_LOCAL_RUNNER=true
REMINDER_POLL_INTERVAL_SECONDS=30
FRONTEND_ORIGIN=http://localhost:5173
